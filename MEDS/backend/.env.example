# Example environment variables for MEDS backend
# Copy to .env and fill values (do NOT commit .env)

# Server
PORT=5000
NODE_ENV=development
LOAD_DOTENV=true

# Database (either use DATABASE_URL or the parts below)
# DATABASE_URL=postgresql://medsuser:medspassword@db:5432/meds_db
DB_HOST=localhost
DB_PORT=5444
DB_USERNAME=medsuser
DB_PASSWORD=medspassword
DB_NAME=meds_db

# JWT
JWT_SECRET=meds_secret_key

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Third-party keys
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
GEMINI_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
